// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  FACILITY_MANAGER
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  RESERVED
  CHECKED_IN
  CANCELLED
  EXPIRED
}

enum SeatZone {
  WINDOW
  CENTER
  QUIET
  COLLABORATIVE
}
enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)

  bookings     Booking[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cafeteria {
  id       String @id @default(uuid())
  name     String
  building String
  floor    Int
  capacity Int

  seats Seat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id            String     @id @default(uuid())
  seatNumber    String
  cafeteriaId   String
  zone          SeatZone
  status        SeatStatus @default(AVAILABLE)
  isWindowSeat  Boolean    @default(false)

  cafeteria Cafeteria @relation(fields: [cafeteriaId], references: [id])
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cafeteriaId, seatNumber])
}

model Reservation {
  id          String        @id @default(uuid())
  userId      String
  bookingDate DateTime
  status      BookingStatus @default(RESERVED)

  user     User      @relation(fields: [userId], references: [id])
  bookings Booking[]
  checkIn  CheckIn?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bookingDate])
}

model Booking {
  id            String @id @default(uuid())
  reservationId String
  userId        String
  seatId        String

  reservation Reservation @relation(fields: [reservationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  seat        Seat        @relation(fields: [seatId], references: [id])

  createdAt DateTime @default(now())

  @@unique([reservationId, seatId])
  @@index([userId])
  @@index([seatId])
}

model CheckIn {
  id            String   @id @default(uuid())
  reservationId String   @unique
  qrToken       String
  checkedInAt   DateTime?

  reservation Reservation @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())
}


